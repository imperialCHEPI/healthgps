{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/imperialCHEPI/healthgps/main/schemas/v1/config/models/jacardimodel.json",
    "type": "object",
    "description": "JACARDI static / init risk-factor model. Ladder steps are opt-in: include Education and/or Employment only when using them. CSV column types may include string (Factor names).",
    "$defs": {
        "jacardiCsvSlot": {
            "type": "object",
            "description": "Named CSV slot (name/format/delimiter/encoding/columns). Column value types are free-form strings (integer, double, string).",
            "properties": {
                "name": {
                    "type": "string"
                },
                "format": {
                    "type": "string"
                },
                "delimiter": {
                    "type": "string"
                },
                "encoding": {
                    "type": "string"
                },
                "columns": {
                    "type": "object"
                }
            },
            "required": [
                "name",
                "format",
                "delimiter",
                "encoding",
                "columns"
            ],
            "additionalProperties": false
        }
    },
    "properties": {
        "$schema": {
            "type": "string"
        },
        "$comment": {
            "type": "string"
        },
        "ModelName": {
            "const": "JacardiModel"
        },
        "Education": {
            "type": "object",
            "description": "SI lookup: method + lookup. BE equations: method + coefficients + knots. At least one CSV pathway should be present; engine currently loads lookup when present.",
            "properties": {
                "method": {
                    "type": "string"
                },
                "lookup": {
                    "$ref": "#/$defs/jacardiCsvSlot"
                },
                "coefficients": {
                    "$ref": "#/$defs/jacardiCsvSlot",
                    "description": "Optional BE multinomial equations coefs"
                },
                "knots": {
                    "$ref": "#/$defs/jacardiCsvSlot",
                    "description": "Optional BE age knots for education RCS"
                }
            },
            "required": [
                "method"
            ],
            "additionalProperties": false
        },
        "Employment": {
            "type": "object",
            "description": "Employment Part A: method + coefficients + recode required. Optional BE knots / pension_step CSVs (schema accepts; yearly package may use them later).",
            "properties": {
                "method": {
                    "type": "string",
                    "description": "Expected: multinomial_static"
                },
                "coefficients": {
                    "$ref": "#/$defs/jacardiCsvSlot",
                    "description": "employment_static_coefs.csv"
                },
                "recode": {
                    "$ref": "#/$defs/jacardiCsvSlot",
                    "description": "employment_4cat_recode.csv"
                },
                "knots": {
                    "$ref": "#/$defs/jacardiCsvSlot",
                    "description": "Optional employment_static_knots.csv (BE)"
                },
                "pension_step": {
                    "$ref": "#/$defs/jacardiCsvSlot",
                    "description": "Optional employment_pension_step_ages.csv (BE)"
                }
            },
            "required": [
                "method",
                "coefficients",
                "recode"
            ],
            "additionalProperties": false
        },
        "MotherGroup": {
            "type": "object",
            "description": "Optional mother-group init (BE). Schema accepts slots; engine load is separate work.",
            "properties": {
                "method": {
                    "type": "string"
                },
                "start": {
                    "$ref": "#/$defs/jacardiCsvSlot"
                }
            },
            "required": [
                "method"
            ],
            "additionalProperties": false
        }
    },
    "required": [
        "ModelName"
    ],
    "additionalProperties": true
}
