{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/imperialCHEPI/healthgps/main/schemas/v1/config/models/jacardimodel.json",
    "type": "object",
    "description": "JACARDI static / init risk-factor model. Include Education and/or Employment only when using them. If a step is present, its CSV slots are required.",
    "properties": {
        "$schema": {
            "type": "string"
        },
        "$comment": {
            "type": "string"
        },
        "ModelName": {
            "const": "JacardiModel"
        },
        "Education": {
            "type": "object",
            "description": "If using education: method + lookup filename required.",
            "properties": {
                "method": {
                    "type": "string"
                },
                "lookup": {
                    "type": "object",
                    "properties": {
                        "name": {
                            "type": "string"
                        },
                        "format": {
                            "type": "string"
                        },
                        "delimiter": {
                            "type": "string"
                        },
                        "encoding": {
                            "type": "string"
                        },
                        "columns": {
                            "type": "object"
                        }
                    },
                    "required": [
                        "name",
                        "format",
                        "delimiter",
                        "encoding",
                        "columns"
                    ],
                    "additionalProperties": false
                }
            },
            "required": [
                "method",
                "lookup"
            ],
            "additionalProperties": false
        },
        "Employment": {
            "type": "object",
            "description": "If using employment: method + coefficients + recode filenames required. Part A SCORE/DRAW then 4-cat recode.",
            "properties": {
                "method": {
                    "type": "string",
                    "description": "Expected: multinomial_static"
                },
                "coefficients": {
                    "description": "employment_static_coefs.csv — Category x Factor x Coefficient for SCORE",
                    "$ref": "../csv_file.json"
                },
                "recode": {
                    "description": "employment_4cat_recode.csv — employment_id 1-6 to employment4_id 1-4",
                    "$ref": "../csv_file.json"
                }
            },
            "required": [
                "method",
                "coefficients",
                "recode"
            ],
            "additionalProperties": false
        }
    },
    "required": [
        "ModelName"
    ],
    "additionalProperties": true
}
