{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/imperialCHEPI/healthgps/main/schemas/v1/config/models/jacardimodelupdate.json",
    "type": "object",
    "description": "JACARDI dynamic / yearly risk-factor model. include Education and/or Employment only when using them. If a step is present, its CSV slots are required.",
    "properties": {
        "$schema": {
            "type": "string"
        },
        "$comment": {
            "type": "string"
        },
        "ModelName": {
            "const": "JacardiModelUpdate"
        },
        "Education": {
            "type": "object",
            "description": "If using education: method + draw_at_19 + upgrade_transitions required; optional lookup for rare 20+ missing fill.",
            "properties": {
                "method": {
                    "type": "string"
                },
                "lookup": {
                    "type": "object",
                    "description": "Optional Part A lookup \u2014 used if someone 20+ is still missing education.",
                    "properties": {
                        "name": {
                            "type": "string"
                        },
                        "format": {
                            "type": "string"
                        },
                        "delimiter": {
                            "type": "string"
                        },
                        "encoding": {
                            "type": "string"
                        },
                        "columns": {
                            "type": "object"
                        }
                    },
                    "required": [
                        "name",
                        "format",
                        "delimiter",
                        "encoding",
                        "columns"
                    ],
                    "additionalProperties": false
                },
                "draw_at_19": {
                    "type": "object",
                    "properties": {
                        "name": {
                            "type": "string"
                        },
                        "format": {
                            "type": "string"
                        },
                        "delimiter": {
                            "type": "string"
                        },
                        "encoding": {
                            "type": "string"
                        },
                        "columns": {
                            "type": "object"
                        }
                    },
                    "required": [
                        "name",
                        "format",
                        "delimiter",
                        "encoding",
                        "columns"
                    ],
                    "additionalProperties": false
                },
                "upgrade_transitions": {
                    "type": "object",
                    "properties": {
                        "name": {
                            "type": "string"
                        },
                        "format": {
                            "type": "string"
                        },
                        "delimiter": {
                            "type": "string"
                        },
                        "encoding": {
                            "type": "string"
                        },
                        "columns": {
                            "type": "object"
                        }
                    },
                    "required": [
                        "name",
                        "format",
                        "delimiter",
                        "encoding",
                        "columns"
                    ],
                    "additionalProperties": false
                }
            },
            "required": [
                "method",
                "draw_at_19",
                "upgrade_transitions"
            ],
            "additionalProperties": false
        },
        "Employment": {
            "type": "object",
            "description": "If using employment: method + coefficients + recode filenames required. First SCORE/DRAW at 19+ when missing; else temporary hold until yearly package.",
            "properties": {
                "method": {
                    "type": "string",
                    "description": "Expected: multinomial_static (first draw + temporary hold until yearly transitions replace hold)"
                },
                "coefficients": {
                    "description": "Same employment_static_coefs.csv as JacardiModel — needed for first draw at 19",
                    "$ref": "../csv_file.json"
                },
                "recode": {
                    "description": "Same employment_4cat_recode.csv as JacardiModel",
                    "$ref": "../csv_file.json"
                }
            },
            "required": [
                "method",
                "coefficients",
                "recode"
            ],
            "additionalProperties": false
        }
    },
    "required": [
        "ModelName"
    ],
    "additionalProperties": true
}
