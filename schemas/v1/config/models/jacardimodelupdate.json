{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://raw.githubusercontent.com/imperialCHEPI/healthgps/main/schemas/v1/config/models/jacardimodelupdate.json",
    "type": "object",
    "description": "JACARDI dynamic / yearly risk-factor model. Ladder steps are opt-in. Employment may be SI hold (coefs+recode) or BE yearly (extra optional slots).",
    "$defs": {
        "jacardiCsvSlot": {
            "type": "object",
            "description": "Named CSV slot (name/format/delimiter/encoding/columns). Column value types are free-form strings.",
            "properties": {
                "name": {
                    "type": "string"
                },
                "format": {
                    "type": "string"
                },
                "delimiter": {
                    "type": "string"
                },
                "encoding": {
                    "type": "string"
                },
                "columns": {
                    "type": "object"
                }
            },
            "required": [
                "name",
                "format",
                "delimiter",
                "encoding",
                "columns"
            ],
            "additionalProperties": false
        }
    },
    "properties": {
        "$schema": {
            "type": "string"
        },
        "$comment": {
            "type": "string"
        },
        "ModelName": {
            "const": "JacardiModelUpdate"
        },
        "Education": {
            "type": "object",
            "description": "Part B: method + draw_at_19 + upgrade_transitions required; optional lookup for rare 20+ missing fill.",
            "properties": {
                "method": {
                    "type": "string"
                },
                "lookup": {
                    "$ref": "#/$defs/jacardiCsvSlot"
                },
                "draw_at_19": {
                    "$ref": "#/$defs/jacardiCsvSlot"
                },
                "upgrade_transitions": {
                    "$ref": "#/$defs/jacardiCsvSlot"
                }
            },
            "required": [
                "method",
                "draw_at_19",
                "upgrade_transitions"
            ],
            "additionalProperties": false
        },
        "Employment": {
            "type": "object",
            "description": "Part B: method + coefficients + recode required (first draw at 19 / hold). Optional BE yearly slots are accepted by schema; engine uses coefs+recode until yearly package is wired.",
            "properties": {
                "method": {
                    "type": "string",
                    "description": "multinomial_static (SI hold) or multinomial_yearly (BE pack)"
                },
                "coefficients": {
                    "$ref": "#/$defs/jacardiCsvSlot"
                },
                "recode": {
                    "$ref": "#/$defs/jacardiCsvSlot"
                },
                "knots": {
                    "$ref": "#/$defs/jacardiCsvSlot"
                },
                "pension_step": {
                    "$ref": "#/$defs/jacardiCsvSlot"
                },
                "yearly_coefficients": {
                    "$ref": "#/$defs/jacardiCsvSlot"
                },
                "yearly_knots": {
                    "$ref": "#/$defs/jacardiCsvSlot"
                },
                "yearly_anchors": {
                    "$ref": "#/$defs/jacardiCsvSlot"
                },
                "education_map": {
                    "$ref": "#/$defs/jacardiCsvSlot"
                },
                "start_duration_shares": {
                    "$ref": "#/$defs/jacardiCsvSlot"
                },
                "statutory_retirement": {
                    "$ref": "#/$defs/jacardiCsvSlot"
                }
            },
            "required": [
                "method",
                "coefficients",
                "recode"
            ],
            "additionalProperties": false
        },
        "MotherGroup": {
            "type": "object",
            "description": "Optional mother-group update (BE). Schema accepts slots; engine load is separate work.",
            "properties": {
                "method": {
                    "type": "string"
                },
                "newborn": {
                    "$ref": "#/$defs/jacardiCsvSlot"
                },
                "draw_at_19_by_mother": {
                    "$ref": "#/$defs/jacardiCsvSlot"
                },
                "upgrade_transitions_by_mother": {
                    "$ref": "#/$defs/jacardiCsvSlot"
                }
            },
            "required": [
                "method"
            ],
            "additionalProperties": false
        }
    },
    "required": [
        "ModelName"
    ],
    "additionalProperties": true
}
